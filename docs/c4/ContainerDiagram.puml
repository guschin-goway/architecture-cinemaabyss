@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title КиноБездна — C4: Контейнерная диаграмма (to-be)

Person(user, "Пользователь", "Смотрит фильмы, управляет подписками, избранным, скидками")
Person(partner, "Внешний партнёр", "Платёжные системы, маркетплейсы, сервисы лояльности, CDN")

System_Boundary(ca, "КиноБездна") {
    Container(proxy, "API Gateway", "Nginx", "Единая точка входа, маршрутизация, аутентификация, фиче-флаги")
    Container(bff, "BFF (Web/Mobile/TV)", "Go/Node.js", "Адаптация API под разные клиенты")

    Container(auth, "Auth Service", "Go", "OAuth2/JWT аутентификация")
    Container(userSvc, "User Service", "Go", "Профили пользователей, предпочтения")
    Container(favorites, "Favorites Service", "Go", "Избранное и пользовательские коллекции")

    Container(movies, "Movies Service", "Go", "Каталог фильмов, жанры, рейтинги")
    Container(search, "Search Service", "ElasticSearch", "Поиск по каталогу")
    Container(streaming, "Streaming Gateway", "Go", "Выдача токенов, интеграция с CDN")
    ContainerDb(mediaStore, "Media Storage", "Object Storage / CDN", "Медиаконтент")
    Container(rec, "Recommendations Service", "Python", "ML-рекомендации, персонализация")

    Container(billing, "Billing Service", "Go", "Заказы и счета")
    Container(payments, "Payments Adapter", "Go", "Интеграция с платёжными системами")
    Container(subs, "Subscriptions Service", "Go", "Управление планами и подписками")
    Container(discounts, "Discounts Service", "Go", "Акции, скидки, промокоды")

    Container(loyalty, "Loyalty/Partners Adapter", "Go", "Интеграции с внешними партнёрскими сервисами")

    ContainerDb(dbCatalog, "Каталог (Postgres)", "Postgres", "Метаданные фильмов")
    ContainerDb(dbUsers, "Пользователи (Postgres)", "Postgres", "Учётные записи, профили")
    ContainerDb(dbBilling, "Биллинг (Postgres)", "Postgres", "Финансовые данные")
    ContainerDb(dbFavorites, "Избранное (Postgres)", "Postgres", "Коллекции и закладки пользователей")
    ContainerDb(redis, "Redis", "In-memory", "Кэш, rate limiting")

    Container(kafka, "Kafka Cluster", "Kafka", "Обмен событиями между сервисами")
    Container(events, "Events Service", "Go", "Обработка событий, саги, оркестрация")

    Container_Ext(monolith, "Монолит (Legacy)", "Go", "Историческая система, частично выполняет доменные функции")
}

' Взаимодействия
Rel(user, proxy, "HTTPS запросы (REST/gRPC)")
Rel(proxy, bff, "Адаптированные вызовы под клиент")
Rel(partner, proxy, "Webhook-и, платежные и партнёрские нотификации")

Rel(bff, auth, "Аутентификация")
Rel(bff, userSvc, "REST API")
Rel(bff, favorites, "REST API")
Rel(bff, movies, "REST/gRPC")
Rel(bff, search, "REST API")
Rel(bff, streaming, "REST API")
Rel(bff, billing, "REST API")
Rel(bff, subs, "REST API")
Rel(bff, discounts, "REST API")
Rel(bff, monolith, "Маршрутизация % (Strangler Fig)")

Rel(movies, dbCatalog, "чтение/запись")
Rel(search, dbCatalog, "индексация")
Rel(userSvc, dbUsers, "чтение/запись")
Rel(favorites, dbFavorites, "чтение/запись")
Rel(billing, dbBilling, "чтение/запись")
Rel(subs, dbBilling, "чтение/запись")
Rel(discounts, dbBilling, "чтение/запись")
Rel(rec, redis, "кэш рекомендаций")

Rel_U(movies, kafka, "События фильмов")
Rel_U(userSvc, kafka, "События пользователей")
Rel_U(billing, kafka, "События платежей")
Rel_U(favorites, kafka, "События закладок")
Rel_U(discounts, kafka, "События акций")
Rel(kafka, events, "Поток событий")
Rel(events, billing, "Оркестрация (саги)")
Rel(events, rec, "События для ML")

Rel(billing, payments, "Интеграция PSP")
Rel(loyalty, partner, "Интеграция с маркетплейсами и сервисами лояльности")
Rel(streaming, mediaStore, "Подписанные ссылки для доступа")

@enduml
